# sfs_riscv64_defconfig
# Minimal Buildroot config for booting SFS module tests under
# qemu-system-riscv64. Produces a gzip'd cpio initramfs only
# no disk-backed rootfs, no package bloat beyond busybox.
#
# Usage (from a Buildroot checkout):
#   cp sfs_riscv64_defconfig configs/
#   make sfs_riscv64_defconfig
#   make
# Output: output/images/rootfs.cpio.gz


### Target architecture ###
BR2_riscv=y
BR2_RISCV_64=y
BR2_RISCV_ISA_RVI=y
BR2_RISCV_ISA_RVM=y
BR2_RISCV_ISA_RVA=y
BR2_RISCV_ISA_RVC=y

### Toolchain, built so the image is reproducible ###
#     depending on the host's gcc-riscv64-linux-gnu package version
BR2_TOOLCHAIN_BUILDROOT_MUSL=y
BR2_TOOLCHAIN_BUILDROOT_CXX=n

### System ###
BR2_SYSTEM_DHCP=""
BR2_TARGET_GENERIC_HOSTNAME="sfs-test"
BR2_TARGET_GENERIC_ISSUE="SFS RISC-V test image"
BR2_TARGET_GENERIC_GETTY_PORT="ttyS0"
BR2_TARGET_GENERIC_GETTY_BAUDRATE_115200=y

### Init: custom init script, not full sysvinit/systemd ###
BR2_INIT_NONE=y
# our own /init (see init.sh below) is installed via the rootfs overlay

# Busybox: default config is fine, no extra applets needed
BR2_PACKAGE_BUSYBOX=y

### No package manager, no extra userland - keep the demo/test log clean ###
# (intentionally nothing else enabled here)

### Filesystem: root fs is not needed as a package, 
#     since kernel boots straight off the second virtio-blk device.
#     Buildroot's job is only to produce the initramfs.
BR2_TARGET_ROOTFS_CPIO=y
BR2_TARGET_ROOTFS_CPIO_GZIP=y
BR2_TARGET_ROOTFS_TAR=n

### Rootfs overlay: drop init script + (later) test binaries here ###
BR2_ROOTFS_OVERLAY="board/sfs/overlay"

### Kernel: build via Buildroot too, so image + kernel are one
#     reproducible artifact from one `make`
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.18"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="board/sfs/linux.config"
BR2_LINUX_KERNEL_IMAGE=y