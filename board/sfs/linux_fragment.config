# linux-fragment.config
#
# Not a full kernel .config - a minimal fragment of the options SFS
# testing actually needs. Merge this onto the stock riscv64 defconfig
# to produce board/sfs/linux.config referenced by the Buildroot defconfig.
#
# Generate the full config (run once, from a Linux source tree, then
# check the resulting .config into board/sfs/linux.config):
#
#   cd linux
#   make ARCH=riscv CROSS_COMPILE=riscv64-linux-gnu- defconfig
#   ./scripts/kconfig/merge_config.sh -m .config /path/to/linux-fragment.config
#   make ARCH=riscv CROSS_COMPILE=riscv64-linux-gnu- olddefconfig
#   cp .config /path/to/board/sfs/linux.config
#
# Buildroot will build the kernel from that checked-in config, so the
# exact same kernel is reproduced on every `docker build`.

# Initramfs support (booting straight from cpio, no disk-backed rootfs)
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y

# virtio, for the QEMU `virt` machine's block device (the SFS test image)
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_BLK=y

# devtmpfs, mounted by /init before anything else
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# Loadable module support - required since SFS is built as an
# out-of-tree .ko and inserted at runtime via insmod, not built-in
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y

# Serial console on ttyS0 (QEMU's -nographic default UART)
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_OF_PLATFORM=y

# VFS/procfs/sysfs basics assumed present by most defconfigs already,
# listed here for clarity of what /init depends on:
CONFIG_PROC_FS=y
CONFIG_SYSFS=y

# Trim the noise: no networking stack, no unrelated block/char drivers,
# no filesystems beyond what SFS itself needs plus tmpfs for /dev backing.
CONFIG_NET=n
CONFIG_WIRELESS=n
CONFIG_SOUND=n
CONFIG_USB_SUPPORT=n