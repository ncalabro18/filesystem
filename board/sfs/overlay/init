#!/bin/sh
# /init - PID 1 for the SFS test/demo image.
#
# Buildroot's overlay mechanism copies this to the rootfs root as-is.
#
# Boot flow:
#   - mount virtual filesystems
#   - load the SFS module
#   - mount the test image (second virtio-blk device, /dev/vdb)
#   - run either the demo block or the test suite, depending on
#   - what's present in /test
#   - clean unmount + module removal
#   - power off - no interactive shell, no hang, deterministic exit


set -u

mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev 2>/dev/null

echo "[init] SFS test image boot"

echo "[init] loading SFS module"
if ! insmod /sfs.ko; then
    echo "[init] FATAL: failed to load sfs.ko"
    poweroff -f
fi

echo "[init] mounting test image /dev/vda -> /mnt/sfs"
mkdir -p /mnt/sfs
if ! mount -t sfs /dev/vda /mnt/sfs; then
    echo "[init] FATAL: failed to mount SFS test image"
    rmmod sfs
    poweroff -f
fi

# Test-suite call
if [ -x tests/run_tests ]; then
    echo "[init] running test suite"
    tests/run_tests /mnt/sfs
    TEST_STATUS=$?
    echo "[init] test suite exit code: $TEST_STATUS"
else
    echo "[init] no test suite present, running basic demo"
    echo "hello from SFS" > /mnt/sfs/test.txt
    cat /mnt/sfs/test.txt
    ls -la /mnt/sfs
    TEST_STATUS=0
fi

echo "[init] unmounting and removing module"
umount /mnt/sfs
rmmod sfs

echo "[init] SFS test image complete (status: $TEST_STATUS)"

poweroff -f